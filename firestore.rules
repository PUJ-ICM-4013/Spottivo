rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Usuarios pueden leer y escribir su propio documento
    match /users/{userId} {
      allow read: if true; // Permitir leer cualquier usuario (para buscar amigos)
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Subcolección de amigos
      match /friends/{friendId} {
        // El dueño puede leer y escribir en su propia subcolección
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // Permitir que un usuario se agregue como amigo en la subcollección de otro usuario
        // Solo si el friendId del path coincide con quien está autenticado
        // y el userId en el documento coincide con quien está autenticado
        allow create: if request.auth != null && 
          request.auth.uid == friendId &&
          request.resource.data.userId == request.auth.uid;
      }
      
      // Subcolección de solicitudes de amistad
      match /friendRequests/{requestId} {
        // El dueño puede leer sus solicitudes
        allow read: if request.auth != null && request.auth.uid == userId;
        
        // Cualquier usuario autenticado puede crear una solicitud en la subcolección del receptor
        // siempre que el receiverId coincida con el userId del documento padre
        allow create: if request.auth != null && 
          request.resource.data.receiverId == userId &&
          request.resource.data.senderId == request.auth.uid;
        
        // Solo el dueño puede actualizar (aceptar/rechazar)
        allow update: if request.auth != null && request.auth.uid == userId;
        
        // Permitir eliminar solicitudes
        allow delete: if request.auth != null && 
          (request.auth.uid == userId || request.auth.uid == resource.data.senderId);
      }
    }
    
    // Ubicaciones - permitir lectura a usuarios autenticados
    match /locations/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Negocios - solo lectura pública
    match /businesses/{businessId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Chats - solo los participantes pueden leer y escribir
    match /chats/{chatId} {
      // Permitir lectura si el usuario está en los participantes
      allow read: if request.auth != null && 
        (resource == null || request.auth.uid in resource.data.participants);
      
      // Permitir crear el chat si el usuario autenticado está en la lista de participantes
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.participants;
      
      // Permitir actualizar/eliminar si el usuario está en los participantes del documento existente
      allow update, delete: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      
      // Subcolección de mensajes
      match /messages/{messageId} {
        // Los participantes del chat pueden leer todos los mensajes
        allow read: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        // Solo el remitente puede crear mensajes y debe ser participante del chat
        allow create: if request.auth != null && 
          request.auth.uid == request.resource.data.senderId &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        // Permitir actualizar mensajes (para marcar como leído)
        allow update: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
    
    // Sitios deportivos - lectura pública, escritura para propietarios
    match /sport_places/{placeId} {
      // Cualquier usuario autenticado puede leer sitios activos
      allow read: if request.auth != null;
      
      // Solo usuarios autenticados pueden crear sitios
      allow create: if request.auth != null && 
        request.resource.data.propietarioId == request.auth.uid;
      
      // Solo el propietario puede actualizar su sitio
      allow update: if request.auth != null && 
        (resource.data.propietarioId == request.auth.uid || 
         resource.data.propietarioEmail == request.auth.token.email);
      
      // Solo el propietario puede eliminar (soft delete)
      allow delete: if request.auth != null && 
        (resource.data.propietarioId == request.auth.uid || 
         resource.data.propietarioEmail == request.auth.token.email);
    }
    
    // Sitios deportivos (colección principal actual)
    match /sportPlaces/{placeId} {
      // Cualquier usuario autenticado puede leer
      allow read: if request.auth != null;
      
      // Solo usuarios autenticados pueden crear, y el propietarioId debe coincidir
      allow create: if request.auth != null && 
        request.resource.data.propietarioId == request.auth.uid;
      
      // Solo el propietario puede actualizar
      allow update: if request.auth != null && 
        (resource.data.propietarioId == request.auth.uid || 
         resource.data.propietarioEmail == request.auth.token.email);
      
      // Solo el propietario puede eliminar
      allow delete: if request.auth != null && 
        (resource.data.propietarioId == request.auth.uid || 
         resource.data.propietarioEmail == request.auth.token.email);
    }
    
    // Comunidades
    match /communities/{communityId} {
      // Usuarios autenticados pueden leer comunidades públicas
      allow read: if request.auth != null;
      
      // Usuarios autenticados pueden crear comunidades
      allow create: if request.auth != null && 
        request.resource.data.creatorId == request.auth.uid;
      
      // Solo el creador puede actualizar la comunidad
      allow update: if request.auth != null && 
        resource.data.creatorId == request.auth.uid;
      
      // Solo el creador puede eliminar la comunidad
      allow delete: if request.auth != null && 
        resource.data.creatorId == request.auth.uid;
      
      // Subcolección de miembros
      match /members/{memberId} {
        // Los miembros pueden leer la lista de miembros
        allow read: if request.auth != null;
        
        // Cualquier usuario autenticado puede unirse (crear su propio documento de miembro)
        allow create: if request.auth != null && 
          request.resource.data.userId == request.auth.uid;
        
        // Solo el usuario puede actualizar su propio documento de miembro
        allow update: if request.auth != null && 
          (request.auth.uid == memberId || 
           get(/databases/$(database)/documents/communities/$(communityId)).data.creatorId == request.auth.uid);
        
        // El usuario puede eliminarse a sí mismo, o el creador puede eliminar a otros
        allow delete: if request.auth != null && 
          (request.auth.uid == memberId || 
           get(/databases/$(database)/documents/communities/$(communityId)).data.creatorId == request.auth.uid);
      }
      
      // Subcolección de mensajes
      match /messages/{messageId} {
        // Los miembros pueden leer los mensajes
        allow read: if request.auth != null && 
          exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
        
        // Los miembros pueden crear mensajes
        allow create: if request.auth != null && 
          request.resource.data.senderId == request.auth.uid &&
          exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
        
        // Los miembros pueden actualizar mensajes (para marcar como leído)
        allow update: if request.auth != null && 
          exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
        
        // Solo el remitente o el creador de la comunidad pueden eliminar mensajes
        allow delete: if request.auth != null && 
          (request.auth.uid == resource.data.senderId || 
           get(/databases/$(database)/documents/communities/$(communityId)).data.creatorId == request.auth.uid);
      }
    }
  }
}
